# Local development: use DATABASE_URL. Clever Cloud provides POSTGRESQL_ADDON_URI automatically.
DATABASE_URL=postgresql://username:password@host:5432/database?sslmode=require
API_PORT=8787
DB_POOL_MAX=1
# Exact browser app origin (scheme + host + optional port), not the API URL.
# In production, replace this with the deployed app origin; multiple origins may be comma-separated.
CLIENT_ORIGIN=http://localhost:4175
API_PROXY_TARGET=http://127.0.0.1:8787
DUMMY_PAYMENT_OUTCOME=success
PAYMENT_PROVIDER=sandbox
PAYMENT_SANDBOX_BASE_URL=https://api.paymongo.com/v1
PAYMENT_SANDBOX_API_KEY=replace-with-your-sandbox-key
PAYMENT_SANDBOX_SECRET_KEY=replace-with-your-sandbox-secret
PAYMONGO_BASE_URL=https://api.paymongo.com/v1
PAYMONGO_SECRET_KEY=replace-with-your-live-or-sandbox-key
PAYMONGO_WEBHOOK_SECRET=replace-with-your-webhook-signing-secret
ALLOW_SIMULATED_PAYMENTS=false
BACKUP_DIRECTORY=.backups